{
  "schedules": [
    {
      "name": "SEP14StartEC2Schedule",
      "description": "Starts EC2 test instance",
      "cronExpression": "cron(52 14 15 9 ? 2026)",
      "executionTimeZone": "America/Chicago",
      "target": {
        "lambdaFunction": "SEP14EC2SchedulerFunction",
        "input": { "action": "start" }
      }
    },
    {
      "name": "SEP14StopEC2Schedule",
      "description": "Stops EC2 test instance",
      "cronExpression": "cron(36 14 15 9 ? 2026)",
      "executionTimeZone": "America/Chicago",
      "target": {
        "lambdaFunction": "SEP14EC2SchedulerFunction",
        "input": { "action": "stop" }
      }
    }
  ]
}
